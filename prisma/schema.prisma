generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -- Documents --------------------------------------------------------------

model DocumentCategory {
  id           Int    @id @default(autoincrement())
  order        Int    @default(0)
  translations Json
}

model AdminDocument {
  id         Int      @id @default(autoincrement())
  order      Int      @default(0)
  categoryId Int
  year       String
  date       String
  downloads  Int      @default(0)
  files      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId, year])
}

// -- KPIs / At a Glance -------------------------------------------------------

model KpiStat {
  id           Int    @id @default(autoincrement())
  order        Int    @default(0)
  icon         String
  value        String
  translations Json
}

model PlatformLocation {
  id           Int    @id @default(autoincrement())
  order        Int    @default(0)
  icon         String
  translations Json
}

// -- Board --------------------------------------------------------------------

model BoardMember {
  id           Int    @id @default(autoincrement())
  order        Int    @default(0)
  name         String
  image        String
  translations Json
}

model PendingBoardSeat {
  id           Int    @id @default(autoincrement())
  order        Int    @default(0)
  name         String
  image        String
  translations Json
}

// -- Growth Journey -------------------------------------------------------------

model GrowthRevenue {
  id       Int    @id @default(autoincrement())
  order    Int    @default(0)
  year     String @unique
  currency String
  value    String
}

model GrowthMilestone {
  id           Int    @id @default(autoincrement())
  order        Int    @default(0)
  translations Json
}

// -- Contact ----------------------------------------------------------------

model ContactSettings {
  id    Int    @id @default(1)
  email String
  phone String
  // Street and city/country lines per language: the country name differs
  // ("SPAIN." against "ESPAÑA.") and so may the street wording.
  translations Json?
  // Superseded by `translations`, kept so the previously deployed admin —
  // which still selects these — keeps working. Mirrors the English lines.
  addressLine1   String
  addressLine2   String
  recipientEmail String
}

// -- Videos -------------------------------------------------------------------

model AdminVideo {
  slot     String @id
  fileName String
  size     String
}

// -- Auth ---------------------------------------------------------------------

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
