generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  EN
  ES
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum AdminRole {
  OWNER
  ADMIN
  EDITOR
}

enum BoardSeatStatus {
  APPOINTED
  PENDING
}

enum PageMediaKind {
  HERO
  COCKPIT_BAND
  POWER_OF_A_SMILE
  GROWTH_DECORATION
  CONTACT_DECORATION
  NAVBAR_LOGO
  FOOTER_LOGO
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String?
  role         AdminRole      @default(EDITOR)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]

  @@index([role])
  @@index([isActive])
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model InvestorPage {
  id             String   @id @default(cuid())
  locale         Locale   @unique
  seoTitle       String
  seoDescription String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MediaAsset {
  id                String             @id @default(cuid())
  name              String
  type              MediaType
  path              String             @unique
  mimeType          String?
  sizeBytes         Int?
  width             Int?
  height            Int?
  altEn             String?
  altEs             String?
  usage             String?
  status            PublishStatus      @default(DRAFT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  documents         InvestorDocument[]
  kpiStats          KpiStat[]
  operatingLocations OperatingLocation[]
  boardMembers      BoardMember[]
  pageMediaSections PageMediaSection[]

  @@index([type])
  @@index([status])
}

model PageMediaSection {
  id           String        @id @default(cuid())
  kind         PageMediaKind
  locale       Locale?
  heading      String?
  alt          String?
  mediaAssetId String
  status       PublishStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  mediaAsset   MediaAsset    @relation(fields: [mediaAssetId], references: [id])

  @@unique([kind, locale])
  @@index([status])
  @@index([mediaAssetId])
}

model NavigationLink {
  id        String   @id @default(cuid())
  locale    Locale
  label     String
  href      String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, sortOrder])
  @@index([isVisible])
}

model DocumentCategory {
  id        String             @id @default(cuid())
  locale    Locale
  slug      String
  title     String
  sortOrder Int                @default(0)
  isVisible Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  documents InvestorDocument[]

  @@unique([locale, slug])
  @@index([locale, sortOrder])
}

model InvestorDocument {
  id              String           @id @default(cuid())
  locale          Locale
  title           String
  year            Int
  publicationDate DateTime
  format          String           @default("PDF")
  fileSizeLabel   String?
  categoryId      String
  fileAssetId     String
  status          PublishStatus    @default(DRAFT)
  sortOrder       Int              @default(0)
  isHighlighted   Boolean          @default(false)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  category        DocumentCategory @relation(fields: [categoryId], references: [id])
  fileAsset       MediaAsset       @relation(fields: [fileAssetId], references: [id])

  @@index([locale, year])
  @@index([categoryId])
  @@index([fileAssetId])
  @@index([status])
}

model GlanceSectionContent {
  id        String   @id @default(cuid())
  locale    Locale   @unique
  accent    String
  title     String
  subtitle  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KpiStat {
  id          String        @id @default(cuid())
  locale      Locale
  label       String
  value       String
  iconAssetId String?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  iconAsset   MediaAsset?    @relation(fields: [iconAssetId], references: [id])

  @@index([locale, sortOrder])
  @@index([status])
  @@index([iconAssetId])
}

model OperatingLocation {
  id          String        @id @default(cuid())
  locale      Locale
  name        String
  description String
  iconAssetId String?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  iconAsset   MediaAsset?    @relation(fields: [iconAssetId], references: [id])

  @@index([locale, sortOrder])
  @@index([status])
  @@index([iconAssetId])
}

model BoardSectionContent {
  id        String   @id @default(cuid())
  locale    Locale   @unique
  accent    String
  title     String
  subtitle  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BoardMember {
  id          String          @id @default(cuid())
  locale      Locale
  name        String
  role        String
  description String?
  imageAssetId String?
  seatStatus  BoardSeatStatus @default(APPOINTED)
  status      PublishStatus   @default(DRAFT)
  sortOrder   Int             @default(0)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  imageAsset  MediaAsset?     @relation(fields: [imageAssetId], references: [id])

  @@index([locale, sortOrder])
  @@index([seatStatus])
  @@index([status])
  @@index([imageAssetId])
}

model GrowthSectionContent {
  id           String   @id @default(cuid())
  locale       Locale   @unique
  title        String
  period       String
  lead         String
  body         String
  chartCaption String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GrowthRevenue {
  id        String        @id @default(cuid())
  year      Int           @unique
  value     Decimal       @db.Decimal(12, 2)
  label     String
  status    PublishStatus @default(PUBLISHED)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([sortOrder])
  @@index([status])
}

model GrowthMilestone {
  id          String        @id @default(cuid())
  locale      Locale
  title       String
  description String
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([locale, sortOrder])
  @@index([status])
}

model BusinessModelSectionContent {
  id        String   @id @default(cuid())
  locale    Locale   @unique
  accent    String
  title     String
  subtitle  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessModelFeature {
  id          String        @id @default(cuid())
  locale      Locale
  title       String
  description String
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([locale, sortOrder])
  @@index([status])
}

model ContactContent {
  id            String   @id @default(cuid())
  locale        Locale   @unique
  accent        String
  heading       String
  subtitle      String
  nameLabel     String
  phoneLabel    String
  emailLabel    String
  messageLabel  String
  consentLabel  String
  submitLabel   String
  successTitle  String
  successMessage String
  errorMessage  String
  contactEmail  String
  contactPhone  String
  addressLines  Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FooterGroup {
  id        String       @id @default(cuid())
  locale    Locale
  title     String
  sortOrder Int          @default(0)
  isVisible Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  links     FooterLink[]

  @@index([locale, sortOrder])
  @@index([isVisible])
}

model FooterLink {
  id        String      @id @default(cuid())
  groupId   String
  label     String
  href      String
  sortOrder Int         @default(0)
  isVisible Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  group     FooterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
  @@index([isVisible])
}

model SocialLink {
  id        String   @id @default(cuid())
  locale    Locale
  platform  String
  label     String
  href      String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, sortOrder])
  @@index([isVisible])
}
